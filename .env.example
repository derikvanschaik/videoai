GEMINI_API_KEY=your_gemini_api_key_here

# ── Editor models ───────────────────────────────────────────────────────────────
STYLE_MODEL=gemini-3.1-pro-preview
SCRIPTER_MODEL=gemini-3.1-pro-preview
TTS_MODEL=gemini-2.5-flash-preview-tts
EDITOR_MODEL=gemini-3.1-pro-preview
CAPTION_MODEL=gemini-2.5-pro

# ── TTS / voice clone ───────────────────────────────────────────────────────────
TTS_VOICE=Kore
CLONE_TTS_URL=http://localhost:8765/generate

# ── Output files ────────────────────────────────────────────────────────────────
OUTPUT_VIDEO=final_edit.mp4
NARRATION_WAV=narration.wav

# ── Video dimensions (width x height) ──────────────────────────────────────────
VIDEO_WIDTH=576
VIDEO_HEIGHT=1024

# ── Caption settings ────────────────────────────────────────────────────────────
WORDS_PER_CAP=4
YELLOW_CHANCE=0.35

# ── Voice clone server (voice-clone/server.py) ──────────────────────────────────
# Required — no defaults. Run the Whisper transcription step in Getting Started to generate these.
VOICE_CLONE_MODEL_ID=mlx-community/Qwen3-TTS-12Hz-0.6B-Base-bf16
VOICE_CLONE_REF_AUDIO=/absolute/path/to/your_voice.wav
VOICE_CLONE_REF_TEXT=/absolute/path/to/transcript.txt
VOICE_CLONE_OUTPUT_DIR=outputs
VOICE_CLONE_PORT=8765
